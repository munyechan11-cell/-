rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // 결(Gyeol) Firestore 보안 규칙 — v4 (Custom Token 기반) · 아직 미배포
    //
    // v3.1 의 문제:
    //   규칙이 걸 수 있는 게 `request.auth != null` 뿐이었다. 그런데 익명 로그인은
    //   웹 API 키만 있으면 누구나 할 수 있고 그 키는 클라이언트 번들에 들어 있다.
    //   → 인터넷의 아무나가 전 매장의 손님 개인정보를 읽고 주문·쿠폰을 조작할 수 있었다.
    //   (firestore.rules.test.ts 의 "아직 못 막는 것" 묶음이 이걸 재현한다)
    //
    // v4 의 전제:
    //   로그인 시 서버가 createCustomToken(user.id, { role, staffLevel,
    //   employerStoreId, employerStatus }) 을 발급하고 클라이언트가
    //   signInWithCustomToken 으로 로그인한다. 그러면 규칙이 비로소
    //   "요청자가 누구이고 어느 매장 소속인지"를 알 수 있다.
    //
    // v4 가 막는 것: 매장 간 격리 + 권한 상승.
    // v4 가 아직 안 하는 것: 직원 등급별 컬렉션 게이트.
    //   컬렉션별 최소 등급을 추측해서 넣으면 직원이 일을 못 하게 된다.
    //   등급 강제는 화면 사용 실측 후 별도로 올린다(현재는 클라이언트 가드가 1차 방어선).
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function role() {
      return signedIn() && 'role' in claims() ? claims().role : '';
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isAgent() {
      return role() == 'print-bridge';
    }

    // 요청자의 소속 매장. 사장은 자기 uid(= user.id = storeId), 직원은 승인된 경우에만
    // employerStoreId. 손님·미승인 직원은 '' 이라 어떤 매장에도 매칭되지 않는다.
    function myStore() {
      return isOwner()
        ? request.auth.uid
        : (role() == 'staff' && claims().get('employerStatus', '') == 'approved'
            ? claims().get('employerStoreId', '')
            : '');
    }

    // 매장 격리. '' 과 비교해 통과하는 일이 없도록 빈 값을 먼저 배제한다.
    function ownsStore(sid) {
      return myStore() != '' && sid == myStore();
    }

    // ⚠️ resource / request.resource 는 요청 종류에 따라 존재하지 않는다
    //    (create 엔 resource 가, delete 엔 request.resource 가 없다).
    //    없는 쪽을 만지면 "Null value error" 로 규칙이 죽는다 — 결과는 거부지만
    //    이유가 "막았다"가 아니라 "터졌다"라서, 다음 수정 때 조용히 뒤집힐 수 있다.
    //    그래서 allow 를 메서드별로 나눠 각자 있는 변수만 만지게 한다.
    //    (scripts/rules-test.mjs 가 Null value error 를 실패로 취급한다)
    // 없는 필드는 기본값으로 받는다(.get). 문서 자체가 없으면 Firestore 가 이 조건을
    // 그냥 거짓으로 처리하므로 별도 null 검사를 넣지 않는다 —
    // `resource == null` 같은 명시적 비교를 넣으면 오히려 규칙이 평가 오류를 뱉는다.
    function existingStore() {
      return resource.data.get('storeId', '');
    }

    function incomingStore() {
      return request.resource.data.get('storeId', '');
    }

    function existingCustomer() {
      return resource.data.get('customerId', '');
    }

    function incomingCustomer() {
      return request.resource.data.get('customerId', '');
    }

    // 요청자가 이 문서의 주인 손님인가.
    function isMine() {
      return signedIn() && existingCustomer() == request.auth.uid;
    }

    function willBeMine() {
      return signedIn() && incomingCustomer() == request.auth.uid;
    }

    // 기존 문서가 내 매장 것인가.
    function ownsExisting() {
      return ownsStore(existingStore());
    }

    // 새로 쓰는 문서가 내 매장 이름표를 달고 있는가 — 남의 매장으로 심는 것을 막는다.
    function ownsIncoming() {
      return ownsStore(incomingStore());
    }

    // 매장 소유 데이터는 아래 4줄을 그대로 반복해 쓴다.
    //
    //   allow get, list: if ownsExisting();
    //   allow create:    if ownsIncoming();
    //   allow update:    if ownsExisting() && ownsIncoming();   // 매장 이전 차단
    //   allow delete:    if ownsExisting();
    //
    // 한 줄짜리 헬퍼(storeScoped())로 묶고 싶지만 그러면 delete 요청에서도
    // request.resource 를, create 요청에서도 resource 를 건드리게 되어 규칙이
    // 평가 오류로 죽는다. 메서드별로 나눠 쓰는 편이 장황해도 정확하다.

    // ============================================================
    // 손님이 매장을 고르기 전에도 봐야 하는 것 — 메뉴·테이블은 공개 열람 허용.
    // (QR 로 들어온 손님은 아직 어느 매장 소속도 아니다. 쓰기는 여전히 매장 사람만.)
    // ============================================================
    match /menus/{id} {
      allow read: if signedIn();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /tables/{id} {
      allow read: if signedIn();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /sections/{id} {
      allow read: if signedIn();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // 손님은 자기 주문만. 매장 사람은 자기 매장 주문 전부.
    match /orders/{id} {
      allow read: if ownsExisting() || isMine();
      allow create: if ownsIncoming() || willBeMine();
      allow update, delete: if ownsExisting();
    }

    // 손님은 자기 쿠폰만 읽는다. 사용 "요청"까지는 손님이 걸 수 있고, 승인은 매장이 한다.
    // (쿠폰 주인이 바뀌지 않는지도 함께 확인 — 남의 쿠폰을 자기 것으로 옮기는 것 차단)
    match /coupons/{id} {
      allow get, list: if ownsExisting() || isMine();
      allow create: if ownsIncoming();
      // 손님은 자기 쿠폰의 "사용 요청"만 걸 수 있다. 주인이 바뀌지 않는지도 함께 본다.
      allow update: if (ownsExisting() && ownsIncoming()) || (isMine() && willBeMine());
      allow delete: if ownsExisting();
    }

    // 나머지 매장 데이터 — 전부 매장 격리.
    match /visits/{id} {
      allow get, list: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /Communications/{id} {
      allow get, list: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /tierOverrides/{id} {
      allow get, list: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /reservations/{id} {
      allow get, list: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /photos/{id} {
      allow read: if signedIn();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /shifts/{id} {
      allow get, list: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /ingredients/{id} {
      allow get, list: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /expenses/{id} {
      allow get, list: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }
    match /marketingDrafts/{id} {
      allow get, list: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // ============================================================
    // users — 계정. storeId 가 없는 손님 계정이 있어 매장으로 나눌 수 없다.
    //
    // 그래서 여기서 막는 것은 두 가지다:
    //   1) 비로그인·익명 접근 (v3.1 의 가장 큰 구멍)
    //   2) 권한 상승 — 본인 문서를 고치면서 role·staffLevel·소속을 바꾸는 것
    //
    // 남는 위험: 사장님 계정은 다른 매장 손님 문서도 읽을 수 있다.
    // 닫으려면 User 에 "이 손님이 방문한 매장" 링크가 필요하고 그건 데이터 모델 변경이라
    // 별도 결정 사항이다. 그래도 v3.1(인터넷의 아무나) 대비로는 큰 폭의 축소다.
    // ============================================================
    function selfDoc(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    // 본인이 자기 문서를 고칠 때 건드리면 안 되는 필드.
    function noPrivilegeEscalation() {
      return request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('staffLevel', 0) == resource.data.get('staffLevel', 0)
          && request.resource.data.get('employerStatus', '') == resource.data.get('employerStatus', '')
          && request.resource.data.get('employerStoreId', '') == resource.data.get('employerStoreId', '')
          && request.resource.data.get('extraPerms', []) == resource.data.get('extraPerms', []);
    }

    match /users/{userId} {
      allow read: if selfDoc(userId) || isOwner() || role() == 'staff';
      // 사장은 직원 등급·손님 정보를 관리해야 하므로 쓰기 허용.
      allow create, update, delete: if isOwner();
      // 본인 문서 — 만들 때는 자유, 고칠 때는 프로필만(등급·소속·역할은 그대로).
      allow create: if selfDoc(userId);
      allow update: if selfDoc(userId) && noPrivilegeEscalation();
    }

    // appState — 마스터 비밀번호 등 앱 전역 설정. 읽기는 로그인 사용자, 쓰기는 사장만.
    match /appState/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    // ============================================================
    // 영수증 인쇄 브릿지
    // ============================================================
    match /print_jobs/{jobId} {
      allow read, delete: if isAgent()
        ? existingStore() == request.auth.uid
        : ownsExisting();
      allow create: if isAgent()
        ? incomingStore() == request.auth.uid
        : ownsIncoming();
      allow update: if isAgent()
        ? (existingStore() == request.auth.uid && incomingStore() == request.auth.uid)
        : (ownsExisting() && ownsIncoming());
    }

    // 서버(Admin SDK) 전용 — 클라이언트 접근 0.
    match /pairing_codes/{code}    { allow read, write: if false; }
    match /store_secrets/{storeId} { allow read, write: if false; }
    match /merchant_map/{id}       { allow read, write: if false; }

    // 명시되지 않은 모든 경로 — 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
