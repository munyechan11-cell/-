{
  "entities": {
    "GlobalState": {
      "title": "GlobalState",
      "description": "The global state of the application containing all data.",
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "description": "List of all users in the system."
        },
        "visits": {
          "type": "array",
          "description": "List of all visits."
        },
        "coupons": {
          "type": "array",
          "description": "List of all coupons."
        },
        "tables": {
          "type": "array",
          "description": "List of all tables."
        },
        "communications": {
          "type": "array",
          "description": "List of all communications."
        },
        "tierOverrides": {
          "type": "array",
          "description": "List of all tier overrides."
        },
        "masterPassword": {
          "type": "string",
          "description": "Master password for the application."
        }
      }
    }
  },
  "firestore": {
    "/appState/global": {
      "schema": {
        "$ref": "#/entities/GlobalState"
      },
      "description": "The single document storing the entire application state."
    }
  }
}
