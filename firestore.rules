rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // 결(Gyeol) Firestore 보안 규칙 — 베타 단계 (v2)
    //
    // 정책:
    // - 사장님/직원/손님 모두 익명 또는 소셜 로그인 후 사용
    // - 따라서 "인증된 요청만 허용" 을 기본 게이트로 둠
    // - 실 데이터 사용 컬렉션을 명시적으로 화이트리스트
    // - 알 수 없는 경로는 기본 거부
    //
    // ⚠️ 베타 → 정식 전환 시 강화 항목:
    //   1. users — 본인 문서만 쓰기, 다른 사용자 PII 읽기 금지
    //   2. orders/coupons — storeId 매칭 검증 (자기 매장 데이터만)
    //   3. tables/menus/reservations — 사장님만 쓰기 (custom claim role)
    //   4. print_jobs — 매장 owner + 페어링된 에이전트만
    // ============================================================

    // 인증 게이트 헬퍼
    function signedIn() {
      return request.auth != null;
    }

    // 매장 운영 데이터 — 인증된 사용자라면 읽기·쓰기 (베타용)
    match /appState/{docId} {
      allow read, write: if signedIn();
    }
    match /users/{userId} {
      allow read, write: if signedIn();
    }
    match /tables/{tableId} {
      allow read, write: if signedIn();
    }
    match /menus/{menuId} {
      allow read, write: if signedIn();
    }
    match /orders/{orderId} {
      allow read, write: if signedIn();
    }
    match /coupons/{couponId} {
      allow read, write: if signedIn();
    }
    match /reservations/{reservationId} {
      allow read, write: if signedIn();
    }

    // 영수증 인쇄 브릿지 (옵션 B 대비)
    match /print_jobs/{jobId} {
      allow read, write: if signedIn();
    }
    match /pairing_codes/{code} {
      allow read, write: if signedIn();
    }

    // 명시되지 않은 경로는 기본 거부 (Firestore 기본 동작이지만 명시)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
