rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // 결(Gyeol) Firestore 보안 규칙 — v3.1 (베타)
    //
    // 인증 모델 한계:
    //   결의 user.id 는 가입 시 generateId() 로 발급되는 자체 ID 라서
    //   Firebase 익명 토큰의 uid 와 일치하지 않음. 따라서
    //   request.auth.uid == userId / storeId == request.auth.uid 같은
    //   매칭 기반 룰은 베타 단계에선 적용 불가.
    //
    //   → 베타 정책: "인증된 사용자만 자유롭게 접근 + 알 수 없는 경로 거부"
    //   비로그인·외부 침입은 100% 차단, PII·매장 간 격리는
    //   정식 출시 전 Custom Token 기반 재설계로 강화.
    //
    // 영수증 브릿지 에이전트:
    //   Custom Token (uid = storeId, claim.role = print-bridge) 보유.
    //   → request.auth != null 통과 + print_jobs 자기 매장만 접근.
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAgent() {
      return signedIn() && request.auth.token.role == 'print-bridge';
    }

    function isAgentForResource(resource) {
      return isAgent() && resource.data.storeId == request.auth.uid;
    }

    // ============================================================
    // 매장 운영 데이터 — 인증된 사용자라면 자유 r/w (베타)
    // ============================================================
    match /appState/{docId}            { allow read, write: if signedIn(); }
    match /users/{userId}              { allow read, write: if signedIn(); }
    match /tables/{tableId}            { allow read, write: if signedIn(); }
    match /menus/{menuId}              { allow read, write: if signedIn(); }
    match /sections/{sectionId}        { allow read, write: if signedIn(); }
    match /tierOverrides/{id}          { allow read, write: if signedIn(); }
    match /orders/{orderId}            { allow read, write: if signedIn(); }
    match /coupons/{couponId}          { allow read, write: if signedIn(); }
    match /visits/{visitId}            { allow read, write: if signedIn(); }
    match /reservations/{id}           { allow read, write: if signedIn(); }
    match /Communications/{id}         { allow read, write: if signedIn(); }
    match /shifts/{id}                 { allow read, write: if signedIn(); }
    match /photos/{id}                 { allow read, write: if signedIn(); }
    match /ingredients/{id}            { allow read, write: if signedIn(); }
    match /expenses/{id}               { allow read, write: if signedIn(); }
    match /marketingDrafts/{id}        { allow read, write: if signedIn(); }

    // ============================================================
    // 영수증 인쇄 브릿지 — 인증된 사장님 + 페어링된 에이전트
    //   에이전트는 자기 매장 print_jobs 만 접근하도록 추가 검증
    // ============================================================
    match /print_jobs/{jobId} {
      allow read, write: if signedIn() && !isAgent();
      allow read, write: if isAgentForResource(resource);
      allow create: if isAgent() && request.resource.data.storeId == request.auth.uid;
    }

    // 페어링 코드는 서버(Admin SDK) 전용 — 클라이언트 0
    match /pairing_codes/{code} {
      allow read, write: if false;
    }

    // 매장 토스 시크릿 키 — 서버(Admin SDK) 전용. 클라이언트는 읽기·쓰기 모두 불가.
    match /store_secrets/{storeId} {
      allow read, write: if false;
    }

    // ============================================================
    // 직원 등급(staffLevel) 서버단 보안 — Custom Token 전환 시 활성화
    //
    // ⚠️ 현재 익명 인증에서는 request.auth.uid ≠ user.id 이므로 규칙이
    //    "요청자가 어느 직원·무슨 등급인지"를 식별할 수 없다.
    //    → 지금은 클라이언트(OwnerShell NAV 필터 + App 라우트 가드)가
    //      등급 권한의 1차 방어선이며, 아래 구조로 Custom Token 을 도입한
    //      뒤 서버단에서 강제한다. (정책 단일 원천: src/lib/staffAccess.ts)
    //
    // 전환 절차:
    //  1) 로그인 시 server.ts 가 createCustomToken(user.id, {
    //       role, staffLevel, employerStoreId }) 발급 → signInWithCustomToken
    //  2) 등급 변경(store.setStaffLevel) 시 admin.setCustomUserClaims(...) +
    //     클라이언트 getIdToken(true) 강제 갱신
    //  3) 아래 함수의 주석을 해제하고, 각 컬렉션 match 의 allow 를 교체
    //
    // function claims()        { return request.auth.token; }
    // function role()          { return claims().role; }
    // function lvl()           { return claims().staffLevel is int ? claims().staffLevel : 1; }
    // function myStore()       { return role() == 'owner' ? request.auth.uid : claims().employerStoreId; }
    // function ownsStore(sid)  { return sid == myStore(); }            // 매장 간 격리
    // function staffAtLeast(n) { return role() == 'owner' || lvl() >= n; }
    //
    // 등급 → 컬렉션 게이트 (staffAccess.ts STAFF_FEATURES 표준 매핑과 동일):
    //   ingredients : write/read = staffAtLeast(3) && ownsStore(...)   // 재고 = 매니저+
    //   expenses    : read       = staffAtLeast(4) && ownsStore(...)   // 정산 = 실장+
    //   visits      : read       = staffAtLeast(3) && ownsStore(...)   // 통계 = 매니저+
    //   Communications : write   = staffAtLeast(2) && ownsStore(...)   // 고객메시지 = 정규직+
    //   users(직원 등급 변경)    : write = role() == 'owner'           // 직원관리 쓰기 = 사장만
    //   그 외 매장 데이터        : ownsStore(resource.data.storeId)    // 전 컬렉션 매장 격리
    //   ※ extraPerms(개별 추가 권한)는 claims 에 함께 실어 staffAtLeast 대신
    //     (staffAtLeast(n) || path in claims().extraPerms) 형태로 확장.
    // ============================================================

    // 명시되지 않은 모든 경로 — 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
