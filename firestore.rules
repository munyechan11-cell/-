rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // 결(Gyeol) Firestore 보안 규칙 — v3 (storeId 매칭·role 게이트 강화)
    //
    // 인증 모델:
    //  - 모든 사용자(사장님·직원·손님)는 익명 로그인 자동화로 request.auth 보유
    //  - 익명·소셜 사용자는 자기 user 문서 id 가 token uid 와 일치
    //  - 영수증 브릿지 에이전트는 Custom Token (uid = storeId, claim.role = "print-bridge")
    //
    // 정책:
    //  1. 인증 없으면 전부 거부
    //  2. users: 본인 문서는 읽기·쓰기, 타인 문서는 매장 매칭 시에만 읽기
    //  3. orders/coupons/visits: 자기 storeId 또는 자기 customerId 만 접근
    //  4. tables/menus/sections: 자기 매장 owner 만 쓰기, 인증된 사용자는 읽기
    //  5. reservations: 자기 매장 owner 만 쓰기, 인증된 사용자는 자기 reservation 만 읽기
    //  6. print_jobs: 자기 매장 owner + 페어링된 에이전트만
    //  7. pairing_codes: 인증된 사용자가 자기 매장 발급, 에이전트는 미인증(서버만 접근)
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAgent() {
      return signedIn() && request.auth.token.role == 'print-bridge';
    }

    // 본인 user 문서인지 (uid == userId)
    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 자기 매장 데이터인지 (resource 의 storeId 가 내 uid 와 같음 — owner 본인)
    function isMyStoreResource(resource) {
      return signedIn() && resource.data.storeId == request.auth.uid;
    }
    function isMyStoreIncoming() {
      return signedIn() && request.resource.data.storeId == request.auth.uid;
    }

    // 자기가 customer 인 데이터인지
    function isMyCustomerResource(resource) {
      return signedIn() && resource.data.customerId == request.auth.uid;
    }

    // 에이전트가 자기 매장 인쇄 작업인지 (uid == storeId)
    function isAgentForResource(resource) {
      return isAgent() && resource.data.storeId == request.auth.uid;
    }

    // ============================================================
    // appState — 전역 설정 (마스터 비밀번호 등). 인증된 사용자 누구나 읽기.
    //            쓰기는 어드민이 콘솔로 직접 (rules 차단 → admin SDK 우회만 가능)
    // ============================================================
    match /appState/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ============================================================
    // users — 사용자(고객·사장님·직원) 프로필
    //   본인 문서: 본인이 자유롭게 읽기·쓰기
    //   타인 문서: 인증된 사용자가 읽기 가능 (전화번호 매칭, 카카오 매칭 등에 필요)
    //              쓰기는 본인만 (사장님이 직원 승인 시는 별도 트랜잭션 — 베타엔 허용)
    // ============================================================
    match /users/{userId} {
      allow read: if signedIn();
      // 본인은 자유 쓰기, 사장님은 자기 매장 직원 데이터도 쓰기 가능
      // (employerStoreId 가 자기 uid 인 경우 — 직원 승인·역할변경용)
      allow create, update: if signedIn() && (
        isSelf(userId) ||
        (resource != null && resource.data.employerStoreId == request.auth.uid) ||
        (request.resource.data.employerStoreId == request.auth.uid)
      );
      // 영수증 브릿지 에이전트는 자기 storeId 문서의 heartbeat 만 갱신 가능
      allow update: if isAgent() && request.auth.uid == userId;
      allow delete: if isSelf(userId);
    }

    // ============================================================
    // tables / menus / sections — 매장 운영 데이터
    //   읽기: 인증된 사용자 누구나 (손님이 메뉴 보기 등)
    //   쓰기: 자기 매장 데이터만
    // ============================================================
    match /tables/{tableId} {
      allow read: if signedIn();
      allow create, update: if isMyStoreIncoming();
      allow delete: if isMyStoreResource(resource);
    }
    match /menus/{menuId} {
      allow read: if signedIn();
      allow create, update: if isMyStoreIncoming();
      allow delete: if isMyStoreResource(resource);
    }
    match /sections/{sectionId} {
      allow read: if signedIn();
      allow create, update: if isMyStoreIncoming();
      allow delete: if isMyStoreResource(resource);
    }
    match /tierOverrides/{id} {
      allow read: if signedIn();
      allow create, update: if isMyStoreIncoming();
      allow delete: if isMyStoreResource(resource);
    }

    // ============================================================
    // orders — 주문
    //   읽기: 자기 매장 owner / 자기 customer / 익명도 자기가 만든 거 (베타엔 허용)
    //   쓰기: 손님이 주문 만들기 (customerId 본인) / 사장님이 상태 변경
    // ============================================================
    match /orders/{orderId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isMyStoreResource(resource) || isMyCustomerResource(resource);
      allow delete: if isMyStoreResource(resource);
    }

    // ============================================================
    // coupons — 쿠폰
    // ============================================================
    match /coupons/{couponId} {
      allow read: if signedIn();
      allow create: if isMyStoreIncoming();
      allow update: if isMyStoreResource(resource) || isMyCustomerResource(resource);
      allow delete: if isMyStoreResource(resource);
    }

    // ============================================================
    // visits — 방문 기록
    // ============================================================
    match /visits/{visitId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.storeId == request.auth.uid
      );
      allow update, delete: if isMyStoreResource(resource);
    }

    // ============================================================
    // reservations / communications / shifts / photos — 매장 owner 전용
    // ============================================================
    match /reservations/{id} {
      allow read: if signedIn();
      allow create, update: if isMyStoreIncoming();
      allow delete: if isMyStoreResource(resource);
    }
    match /Communications/{id} {
      allow read: if signedIn();
      allow create, update: if isMyStoreIncoming();
      allow delete: if isMyStoreResource(resource);
    }
    match /shifts/{id} {
      allow read: if signedIn();
      allow create, update: if isMyStoreIncoming();
      allow delete: if isMyStoreResource(resource);
    }
    match /photos/{id} {
      allow read: if signedIn();
      allow create, update: if isMyStoreIncoming();
      allow delete: if isMyStoreResource(resource);
    }

    // ============================================================
    // print_jobs — 영수증 인쇄 큐 (브릿지)
    //   생성: 자기 매장 사장님이 발행
    //   읽기/업데이트: 자기 매장 사장님 + 페어링된 에이전트 (claim.role)
    //   삭제: 사장님이 정리할 때
    // ============================================================
    match /print_jobs/{jobId} {
      allow create: if isMyStoreIncoming();
      allow read: if isMyStoreResource(resource) || isAgentForResource(resource);
      allow update: if isMyStoreResource(resource) || isAgentForResource(resource);
      allow delete: if isMyStoreResource(resource);
    }

    // ============================================================
    // pairing_codes — 6자리 페어링 코드 (5분 TTL, 1회용)
    //   서버(Admin SDK)만 생성·읽기·삭제. 클라이언트는 절대 직접 접근 불가.
    // ============================================================
    match /pairing_codes/{code} {
      allow read, write: if false;
    }

    // ============================================================
    // 명시되지 않은 모든 경로 — 기본 거부
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
